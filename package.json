{
  "name": "perumda-ledger",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node server/index.cjs",
    "db:init": "node server/db/seed.cjs",
    "start": "node server/index.cjs",
    "qa:db:clone": "node scripts/qa_clone_db.cjs",
    "qa:db:reset": "node scripts/qa_clone_db.cjs --force",
    "qa:server": "DB_PATH=server/perumda_ledger.qa.db PORT=3002 node server/index.cjs",
    "qa:dev": "vite --mode qa",
    "qa:build": "vite build --mode qa",
    "qa:start": "npm run qa:db:clone && npm run qa:build && DB_PATH=server/perumda_ledger.qa.db PORT=3002 NODE_ENV=production node server/index.cjs",
    "test:reports": "node --test tests/reports/",
    "postinstall": "npm rebuild sqlite3 --build-from-source"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "chart.js": "^4.4.4",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "file-saver": "^2.0.5",
    "lucide-react": "^0.441.0",
    "puppeteer": "^24.43.0",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "sqlite3": "^6.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "playwright": "^1.59.1",
    "vite": "^5.4.6"
  }
}
